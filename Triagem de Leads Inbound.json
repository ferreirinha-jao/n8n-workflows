        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"temperature\": 0.3,\n  \"reasoning_effort\": \"low\",\n  \"reasoning_format\": \"hidden\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Você é um SDR especialista em triagem de leads inbound. Analise o lead e responda APENAS com um objeto JSON válido, sem texto adicional, com exatamente estas chaves: score (número inteiro de 1 a 10 indicando a prioridade do lead), classificacao (string, exatamente um destes valores: Quente, Morno ou Frio), resumo (string, uma frase resumindo o que o lead precisa), sugestao_resposta (string, mensagem curta e cordial que o vendedor pode enviar no WhatsApp).\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(\"Analise este lead inbound:\\n\\nNome: \" + $json.body.nome + \"\\nEmail: \" + $json.body.email + \"\\nTelefone: \" + $json.body.telefone + \"\\nMensagem: \" + $json.body.mensagem + \"\\nOrçamento: \" + $json.body.orcamento) }} }\n  ]\n}",
        "options": {}
