      "parameters": {
        "jsCode": "const raw = $('Receber Lead (Webhook)').item.json.body || {};\nconst content = $json.choices[0].message.content;\nlet ai = {};\ntry {\n  ai = typeof content === 'string' ? JSON.parse(content) : (content || {});\n} catch (e) {\n  ai = {};\n}\nreturn [{ json: {\n  nome: raw.nome,\n  email: raw.email,\n  telefone: raw.telefone,\n  mensagem: raw.mensagem,\n  orcamento: raw.orcamento,\n  score: ai.score,\n  classificacao: ai.classificacao,\n  resumo: ai.resumo,\n  sugestao_resposta: ai.sugestao_resposta,\n} }];"
      },
