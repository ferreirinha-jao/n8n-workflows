    },
    {
      "parameters": {
        "jsCode": "const raw = $('Receber Lead (Webhook)').item.json.body || {};\nconst err = $json.error || {};\nconst errMsg = err.message || err.description || err.reason || (typeof $json.message === 'string' ? $json.message : '') || 'Falha desconhecida na API da Groq';\nreturn [{ json: {\n  nome: raw.nome,\n  email: raw.email,\n  telefone: raw.telefone,\n  mensagem: raw.mensagem,\n  orcamento: raw.orcamento,\n  score: '',\n  classificacao: 'Pendente (falha IA)',\n  resumo: 'Análise automática indisponível - classificar manualmente.',\n  sugestao_resposta: '',\n  erro_ia: String(errMsg),\n} }];"
