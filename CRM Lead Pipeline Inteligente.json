    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"qualificado\": true,\n  \"nome\": \"João Silva\",\n  \"telefone\": \"+55 11 99999-0000\",\n  \"origem\": \"Instagram\",\n  \"problema\": \"Precisa automatizar atendimento no WhatsApp\",\n  \"orcamento\": \"R$ 5.000\",\n  \"urgencia\": \"Alta - quer começar este mês\",\n  \"ja_usou_antes\": \"Sim, usou uma ferramenta parecida\",\n  \"classificacao\": \"Quente\",\n  \"tipo_cliente\": \"Novo\",\n  \"score\": 82,\n  \"resumo\": \"Lead novo, problema claro, orçamento definido e urgência alta.\"\n}"
      },
