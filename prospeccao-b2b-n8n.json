            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Você é um especialista em vendas B2B e prospecção fria (Outbound Mail). Sua função é criar abordagens diretas, personalizadas e de alto impacto para executivos, sem parecer spam ou vendedor desesperado.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analise o lead abaixo e crie uma abordagem fria (Cold E-mail) curta e personalizada.\\n\\nDADOS DO LEAD:\\n- Nome: {{ $('HTTP Request - Apify').item.json.first_name }} {{ $('HTTP Request - Apify').item.json.last_name }}\\n- Cargo: {{ $('HTTP Request - Apify').item.json.title }}\\n- Empresa: {{ $('HTTP Request - Apify').item.json.organization.name }}\\n- LinkedIn: {{ $('HTTP Request - Apify').item.json.linkedin_url }}\\n\\nREGRAS DE RESPOSTA:\\n1. Retorne ESTRITAMENTE um objeto JSON válido.\\n2. NADA de marcações Markdown (sem ```json), texto introdutório ou explicações adicionais.\\n3. O assunto deve ter no máximo 5 palavras e despertar curiosidade.\\n4. O corpo do e-mail deve ter no máximo 3 parágrafos curtos focados no desafio do cargo de {{ $('HTTP Request - Apify').item.json.title }}.\\n5. O objetivo final do e-mail é propor uma conversa rápida de 15 minutos.\\n\\nESTRUTURA DO JSON ESPERADO:\\n{\\n  \\\"assunto_email\\\": \\\"Texto do assunto aqui\\\",\\n  \\\"corpo_email\\\": \\\"Texto completo do e-mail aqui\\\"\\n}\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 1000\n}",
        "options": {}
      },
      "id": "1a2b3c4d-0003-0003-0003-000000000003",
      "name": "Groq AI - Cold Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const groqResponse = items[0].json;\nconst rawContent = groqResponse.choices[0].message.content;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawContent);\n} catch (e) {\n  const match = rawContent.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    parsed = JSON.parse(match[0]);\n  } else {\n    throw new Error('Não foi possível extrair JSON da resposta do Groq: ' + rawContent);\n  }\n}\n\nreturn [{\n  json: {\n    assunto_email: parsed.assunto_email,\n    corpo_email: parsed.corpo_email\n  }\n}];"
      },
